<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StartScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="192dp"
            android:layout_height="192dp"
            android:layout_gravity="center"
            android:contentDescription="Logo of Preguntados"
            android:src="@drawable/app_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="PREGUNTADOS"
            android:fontFamily="sans-serif-black"
            android:textSize="36sp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <ImageButton
            android:id="@+id/start_button"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:backgroundTint="#00000000"
            android:contentDescription="Play button"
            android:src="@drawable/bt_play" />

        <ImageButton
            android:id="@+id/options_button"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:backgroundTint="#00000000"
            android:contentDescription="Options button"
            android:src="@drawable/bt_options" />

        <ImageButton
            android:id="@+id/leaderboard_button"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:backgroundTint="#00000000"
            android:contentDescription="Leaderboard button"
            android:src="@drawable/bt_leaderboard"
            android:clickable="false"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>