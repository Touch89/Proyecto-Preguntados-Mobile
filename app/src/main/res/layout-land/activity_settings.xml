<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

       <LinearLayout
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:orientation="vertical">

           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_gravity="center_horizontal"
               android:layout_marginBottom="16dp"
               android:text="@string/settings"
               android:textSize="28sp"
               android:textStyle="bold" />

           <LinearLayout
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:gravity="center_vertical"
               android:orientation="horizontal">

               <CheckBox
                   android:id="@+id/cb_geografia"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="" />

               <ImageView
                   android:id="@+id/geografia_label"
                   android:layout_width="170dp"
                   android:layout_height="46dp"
                   android:contentDescription="@string/topic_geografia"
                   android:background="@android:color/transparent" />
           </LinearLayout>

           <LinearLayout
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:gravity="center_vertical"
               android:orientation="horizontal">

               <CheckBox
                   android:id="@+id/cb_historia"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="" />

               <ImageView
                   android:id="@+id/cine_label"
                   android:layout_width="170dp"
                   android:layout_height="46dp"
                   android:background="@android:color/transparent"
                   android:contentDescription="@string/topic_historia" />
           </LinearLayout>

           <LinearLayout
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:gravity="center_vertical"
               android:orientation="horizontal">

               <CheckBox
                   android:id="@+id/cb_ciencia"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="" />

               <ImageView
                   android:id="@+id/tecnologia_label"
                   android:layout_width="170dp"
                   android:layout_height="46dp"
                   android:background="@android:color/transparent"
                   android:contentDescription="@string/topic_ciencia" />
           </LinearLayout>

           <LinearLayout
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:gravity="center_vertical"
               android:orientation="horizontal">

               <CheckBox
                   android:id="@+id/cb_deportes"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="" />

               <ImageView
                   android:id="@+id/deportes_label"
                   android:layout_width="170dp"
                   android:layout_height="46dp"
                   android:background="@android:color/transparent"
                   android:contentDescription="@string/topic_deportes" />
           </LinearLayout>

           <LinearLayout
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:gravity="center_vertical"
               android:orientation="horizontal">

               <CheckBox
                   android:id="@+id/cb_arte"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="" />

               <ImageView
                   android:id="@+id/astronomia_label"
                   android:layout_width="170dp"
                   android:layout_height="46dp"
                   android:background="@android:color/transparent"
                   android:contentDescription="@string/topic_arte" />
           </LinearLayout>

       </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="16dp">
            <TextView
                android:id="@+id/tv_question_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/questions_count_default" />

            <SeekBar
                android:id="@+id/seek_questions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:scaleY="1.3"
                android:max="5"
                android:progress="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/difficulty_label" />

            <Spinner
                android:id="@+id/spinner_difficulty"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:minHeight="56dp" />

            <Switch
                android:id="@+id/switch_hints"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:switchMinWidth="68dp"
                android:textSize="20sp"
                android:text="@string/enable_hints" />

            <LinearLayout
                android:id="@+id/hints_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_hints_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hints_available_default" />
            </LinearLayout>

            <Button
                android:id="@+id/save_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/save_button"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>